{% set _serial = current_forward_serial | default('2026111901') %}
$TTL 3600
@   IN  SOA {{ bind_ns_host }}. {{ bind_admin_email }}. (
            {{ _serial }} ; Serial
            3600       ; Refresh
            900        ; Retry
            604800     ; Expire
            86400 )    ; Minimum TTL

; Name Servers
@   IN  NS  {{ bind_ns_host }}.

; Static Infrastructure Records
{% for rec in bind_static_a_records %}
{{ "%-24s" | format(rec.name) }} IN  A   {{ rec.ip }}
{% endfor %}

; Provisioned VM Records (from hosts.yml)
{% for vm in vms if vm.name is defined and vm.name | length > 0 and vm.ip is defined %}
{% set short_name = vm.name.split('.') %}
{{ "%-24s" | format(short_name) }} IN  A   {{ vm.ip }}
{% endfor %}

