{
  "Dhcp4": {
    "loggers": [
      {
        "name": "kea-dhcp4",
        "severity": "INFO",
        "output_options": [
          {
            "output": "/var/log/kea/dhcp4.log",
            "maxver": 10
          }
        ]
      },
      {
        "name": "kea-dhcp4.dhcpsrv",
        "severity": "INFO",
        "output_options": [
          {
            "output": "/var/log/kea/dhcp4-dhcpsrv.log",
            "maxver": 10
          }
        ]
      },
      {
        "name": "kea-dhcp4.leases",
        "severity": "INFO",
        "output_options": [
          {
            "output": "/var/log/kea/dhcp4-leases.log",
            "maxver": 10
          }
        ]
      }
    ],
    "interfaces-config": {
      "interfaces": [
        "enX0"
      ]
    },
    "lease-database": {
      "type": "memfile",
      "lfc-interval": 3600,
      "name": "dhcp4.leases",
      "persist": true
    },
    "expired-leases-processing": {
      "reclaim-timer-wait-time": 10,
      "flush-reclaimed-timer-wait-time": 25,
      "hold-reclaimed-time": 3600,
      "max-reclaim-leases": 100,
      "max-reclaim-time": 250,
      "unwarned-reclaim-cycles": 5
    },
    "reservations-global": false,
    "reservations-in-subnet": true,
    "reservations-out-of-pool": false,
    "valid-lifetime": 3600,
    "calculate-tee-times": true,
    "renew-timer": 900,
    "rebind-timer": 1800,
    "ddns-send-updates": true, 
    "ddns-qualifying-suffix": "spivacks.net",
    "dhcp-ddns": {
        "enable-updates": true,
        "server-ip": "127.0.0.1",
        "server-port": 53001
    },
    "option-data": [
      {
        "name": "domain-name-servers",
        "data": "10.10.10.20",
        "always-send": true
      },
      {
        "name": "domain-name",
        "data": "spivacks.net"
      }
    ],
     "subnet4": [
{% for subnet in kea_dhcp4_subnets_definition %}
      {
        "id": {{ subnet.id }},
        "subnet": "{{ subnet.subnet }}",
        "pools": [
{% for pool in subnet.pools %}
          {
            "pool": "{{ pool }}"
          }{{ "," if not loop.last else "" }}
{% endfor %}
        ],
        "option-data": [
          {
            "name": "routers",
            "data": "{{ subnet.gateway }}"
          }
        ],
        "reservations": [
{% set subnet_clients = [] %}
{% for client in groups['dhcp_clients'] %}
  {% if hostvars[client].subnet_id == subnet.id %}
    {% set _ = subnet_clients.append(client) %}
  {% endif %}
{% endfor %}
{% for client in subnet_clients %}
          {
            "hw-address": "{{ hostvars[client].mac_address }}",
            "ip-address": "{{ hostvars[client].ansible_host }}",
            "hostname": "{{ client }}"
          }{{ "," if not loop.last else "" }}
{% endfor %}
        ]
      }{{ "," if not loop.last else "" }}
{% endfor %}
    ],
